# irdiff.tcl --
#
#	Extract the widget interface from two Tk source trees and print the
#	differences: classes, options (type, default, flags, enumeration
#	values), subcommands and their evidence status, geometry-manager
#	options and value types.  Used to check that a Tk update produces a
#	predictable, reviewable change of the extracted schema.
#
#	tclsh tools/irdiff.tcl OLD_TK OLD_TCL NEW_TK NEW_TCL ?OUTFILE?

set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root generator extract.tcl]

proc summarize {ir} {
    set s [dict create]
    dict for {cmd c} [dict get $ir classes] {
	foreach o [dict get $c options] {
	    set d [dict get $o default]
	    if {[dict exists $d platformDependent]} { set d [dict get $d values unix] }
	    set rec [list type [dict get $o type] default $d flags [dict get $o flags]]
	    if {[dict exists $o enumValues]} { lappend rec values [dict get $o enumValues] }
	    if {[dict exists $o synonymOf]} { lappend rec alias [dict get $o synonymOf] }
	    dict set s "option $cmd [dict get $o optionName]" $rec
	}
	foreach sc [dict get $c commands] {
	    set ev [dict get $sc evidence]
	    set st [expr {$ev eq {} ? "table" : [dict get $ev status]}]
	    set us [expr {$ev eq {} ? {} : [lmap u [dict get $ev usages] {dict get $u usage}]}]
	    dict set s "subcommand $cmd [join [dict get $sc path]]" [list evidence $st usage $us]
	}
    }
    dict for {mgr g} [dict get $ir geometry] {
	foreach sub [dict get $g subcommands] {
	    dict set s "geometry $mgr subcommand [dict get $sub name]" \
		[list handler [dict get $sub handler] deprecated [dict get $sub deprecated]]
	}
	dict for {h hv} [dict get $g handlers] {
	    foreach o [dict get $hv options] {
		dict set s "geometry $mgr $h [dict get $o name]" [list type [dict get $o type]]
	    }
	}
    }
    return $s
}

lassign $argv oldTk oldTcl newTk newTcl out
set a [summarize [::tkx::extract::run $oldTk $oldTcl]]
set aid [dict get [::tkx::extract::Identity] tk patchLevel]
set b [summarize [::tkx::extract::run $newTk $newTcl]]
set bid [dict get [::tkx::extract::Identity] tk patchLevel]

set lines {}
set counts [dict create added 0 removed 0 changed 0]
foreach k [lsort -unique [concat [dict keys $a] [dict keys $b]]] {
    if {![dict exists $a $k]} {
	lappend lines "+ $k  [dict get $b $k]"
	dict incr counts added
    } elseif {![dict exists $b $k]} {
	lappend lines "- $k  [dict get $a $k]"
	dict incr counts removed
    } elseif {[dict get $a $k] ne [dict get $b $k]} {
	set ch {}
	dict for {f v} [dict get $b $k] {
	    set ov [expr {[dict exists [dict get $a $k] $f] ? [dict get $a $k $f] : ""}]
	    if {$ov ne $v} { lappend ch "$f: {$ov} -> {$v}" }
	}
	lappend lines "~ $k  [join $ch {; }]"
	dict incr counts changed
    }
}
set text "Extracted schema diff: Tk $aid -> Tk $bid\n"
append text "(generated by tools/irdiff.tcl; + added, - removed, ~ changed)\n"
append text "entries: [dict size $a] -> [dict size $b]; added [dict get $counts added],\
	removed [dict get $counts removed], changed [dict get $counts changed]\n\n"
append text [join $lines \n]\n
if {$out ne ""} {
    set f [open $out w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $text
    close $f
} else {
    puts -nonewline $text
}
