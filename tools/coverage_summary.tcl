# coverage_summary.tcl --
#
#	Produce the quantitative tables of docs/COVERAGE_TABLES.md from the
#	extraction and generation pipeline (and, if present, from the
#	behavioural coverage file written by the test suite).
#
#	tclsh tools/coverage_summary.tcl TK_SRC TCL_SRC ?BEHAVIOR_FILE? ?OUTFILE?

set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root generator generate.tcl]

lassign $argv tk tcl behavior out
set ir [::tkx::extract::run $tk $tcl]
::tkx::gen::Build $ir
set funcs $::tkx::gen::funcs
set cov $::tkx::gen::cov

set called {}
if {$behavior ne "" && [file exists $behavior]} {
    set f [open $behavior]
    foreach line [split [read $f] \n] {
	if {[lindex $line 0] eq "CALLED"} { dict set called [lindex $line 1] 1 }
    }
    close $f
}

proc row {args} { return "| [join $args { | }] |" }
set md "# Coverage tables (generated)\n\n"
append md "Generated by `tools/coverage_summary.tcl` from Tk [dict get $ir source tk patchLevel]"
append md " (manifest `[string range [dict get $ir source tk manifest] 0 11]`).  Do not edit by hand.\n\n"

# ---- Options per class
append md "## Options per discovered widget class\n\n"
append md "Status of every option found in the class's Tk_OptionSpec chain.\n"
append md "`generated` = typed setter+getter, `readonly` = getter only (ttk READONLY_OPTION or classic\n"
append md "create-only), `callback` = C function pointer, `alias` = TK_OPTION_SYNONYM (no function),\n"
append md "`excluded` = schema overlay says why, `unsupported` = no C mapping (reported, not guessed).\n\n"
set states {generated readonly callback alias excluded unsupported internal}
append md [row class selected discovered {*}$states] "\n"
append md [row --- --- --- {*}[lrepeat [llength $states] ---]] "\n"
set tot [dict create discovered 0]
set totSel [dict create discovered 0]
foreach cmd [lsort [dict keys $cov]] {
    set c [dict get $cov $cmd]
    set sel [dict exists $::tkx::gen::selection $cmd]
    set cells {}
    foreach s $states {
	set n [expr {[dict exists $c counts $s] ? [dict get $c counts $s] : 0}]
	lappend cells $n
	dict incr tot $s $n
	if {$sel} { dict incr totSel $s $n }
    }
    dict incr tot discovered [dict get $c total]
    if {$sel} { dict incr totSel discovered [dict get $c total] }
    append md [row $cmd [expr {$sel ? "yes" : ""}] [dict get $c total] {*}$cells] "\n"
}
foreach {label t} [list "**all classes**" $tot "**selected classes**" $totSel] {
    set cells {}
    foreach s $states { lappend cells [expr {[dict exists $t $s] ? [dict get $t $s] : 0}] }
    append md [row $label "" [dict get $t discovered] {*}$cells] "\n"
}

# ---- Subcommand evidence
append md "\n## Subcommand evidence per discovered class\n\n"
append md "`complete` = arity, argument conversions and result fully inferred (typed function generated\n"
append md "automatically for selected classes); `partial` = something could not be inferred (overlay or\n"
append md "generic call needed); `script-argument` = an argument is evaluated as Tcl code (never generated);\n"
append md "`option-mechanism` = cget/configure (covered by option accessors); `classic-table` = classic\n"
append md "widget subcommand names from a string table.\n\n"
set evs {complete partial script-argument option-mechanism classic-table}
append md [row class subcommands {*}$evs] "\n"
append md [row --- --- {*}[lrepeat [llength $evs] ---]] "\n"
set etot [dict create n 0]
foreach cmd [lsort [dict keys $cov]] {
    set c [dict get $cov $cmd]
    set cells {}
    foreach e $evs {
	set n [expr {[dict exists $c evidence $e] ? [dict get $c evidence $e] : 0}]
	lappend cells $n
	dict incr etot $e $n
    }
    dict incr etot n [dict get $c commands]
    append md [row $cmd [dict get $c commands] {*}$cells] "\n"
}
set cells {}
foreach e $evs { lappend cells [expr {[dict exists $etot $e] ? [dict get $etot $e] : 0}] }
append md [row "**all classes**" [dict get $etot n] {*}$cells] "\n"

# ---- Generated functions
append md "\n## Generated functions (selected classes and geometry managers)\n\n"
append md "Approach: `extracted` = declarative tables only; `inferred` = evidence from function bodies;\n"
append md "`schema` = an overlay supplied missing semantics.  Behaviourally tested = called successfully\n"
append md "(status TKX_OK) by the tcltest suite, which also checks the result against Tk.\n\n"
append md [row group functions extracted inferred schema "behaviourally tested"] "\n"
append md [row --- --- --- --- --- ---] "\n"
set g [dict create]
foreach f $funcs {
    set grp [dict get $f class]
    dict incr g "$grp,n"
    dict incr g "$grp,[dict get $f approach]"
    if {[dict exists $called [dict get $f name]]} { dict incr g "$grp,tested" }
    dict incr g "ALL,n"
    dict incr g "ALL,[dict get $f approach]"
    if {[dict exists $called [dict get $f name]]} { dict incr g "ALL,tested" }
}
set groups [lsort -unique [lmap f $funcs {dict get $f class}]]
foreach grp [concat $groups ALL] {
    set cells {}
    foreach k {n extracted inferred schema tested} {
	lappend cells [expr {[dict exists $g "$grp,$k"] ? [dict get $g "$grp,$k"] : 0}]
    }
    append md [row [expr {$grp eq "ALL" ? "**total**" : $grp}] {*}$cells] "\n"
}

# ---- Geometry
append md "\n## Geometry managers\n\n"
foreach mgr {grid pack} {
    set gm [dict get $ir geometry $mgr]
    set nsub [llength [dict get $gm subcommands]]
    set ndep [llength [lsearch -all -index 1 -exact [lmap s [dict get $gm subcommands] {list x [dict get $s deprecated]}] 1]]
    set nopt 0; set ntyped 0
    dict for {h hv} [dict get $gm handlers] {
	foreach o [dict get $hv options] {
	    incr nopt
	    if {[dict get $o type] ne "unknown"} { incr ntyped }
	}
    }
    append md "- **$mgr**: $nsub subcommands discovered ($ndep deprecated), $nopt option names in handler tables, $ntyped value types inferred from conversion calls.\n"
}
set skipped $::tkx::gen::geoSkipped
if {[llength $skipped]} {
    append md "- Not generated: [join [lmap s $skipped {format {%s %s (%s)} {*}$s}] {; }].\n"
}

# ---- Diagnostics
set warn [llength [lsearch -all -index 0 -exact [dict get $ir diagnostics] warning]]
append md "\n## Extraction diagnostics\n\n$warn warnings (platform-specific entries, configuration-dependent tables); see `generated/coverage.json`.\n"

if {$out ne ""} {
    set f [open $out w]
    fconfigure $f -encoding utf-8 -translation lf
    puts -nonewline $f $md
    close $f
} else {
    puts -nonewline $md
}
